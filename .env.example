# ─── Sample env file — copy to .env and edit for your environment ───
#
# This file is committed to git so new developers know what env vars
# the app reads. The real `.env` and `.env.production` files should
# stay UNCOMMITTED (add them to .gitignore) because they may contain
# environment-specific URLs.
#
# Vite quirk: every variable must be prefixed with VITE_ to be exposed
# to the browser bundle.

# Base URL of the HRMS backend API. Include the trailing `/api`.
# Local dev:  http://localhost:8001/api
# Production: https://your-backend-host.example.com/api
VITE_API_URL=http://localhost:8001/api
